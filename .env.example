# =========================================================================
# GROWIN Multi-Strategy Trading Engine — Environment Variables
# =========================================================================
# Salin file ini ke lingkungan kamu dan isi nilainya.
#   - Lokal (tes): export ... atau pakai dotenv
#   - Vercel: Project Settings -> Environment Variables (Production)
#     https://vercel.com/dashboard -> pilih project -> Settings -> Environment Variables
# =========================================================================

# --- Upstash Redis (riwayat digest harian + ringkasan mingguan) ---
# Dapatkan dari https://console.upstash.com -> pilih database -> REST API.
# OPSIONAL: tanpa ini aplikasi tetap jalan; hanya fitur riwayat harian yang
# nonaktif (digest pagi tetap berfungsi, riwayat_tersimpan = false).
UPSTASH_REDIS_REST_URL=https://xxx-xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=XXXX_ISI_DENGAN_TOKEN_REST_KAMU_XXXX
